<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CreatorsForge.Foundry.App"
    Title="{Binding WindowTitle}"
    MinWidth="900"
    MinHeight="600"
    Closing="Window_Closing"
    AutomationProperties.Name="Creators Forge Foundry workspace">
  <Window.Resources>
    <HierarchicalDataTemplate
        DataType="{x:Type local:ProjectTreeItemViewModel}"
        ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal">
        <Border
            Width="35"
            Height="18"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Background="{DynamicResource ButtonBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="2">
          <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontFamily="Consolas"
              FontSize="9"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AccentBrush}"
              Text="{Binding IconLabel}" />
        </Border>
        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
      </StackPanel>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project…" InputGestureText="Ctrl+N" Click="NewProject_Click" />
        <MenuItem Header="_Open Project…" InputGestureText="Ctrl+O" Click="OpenProject_Click" />
        <MenuItem Header="New _Workspace..." Click="NewWorkspace_Click" />
        <MenuItem Header="Open W_orkspace..." Click="OpenWorkspace_Click" />
        <MenuItem Header="_Add Project to Workspace..." Click="AddProjectToWorkspace_Click" />
        <Separator />
        <MenuItem Header="_Import Project Template..." Click="ImportProjectTemplate_Click" />
        <MenuItem Header="_Export Project Template..." Click="ExportProjectTemplate_Click" />
        <MenuItem Header="_Recent Projects" ItemsSource="{Binding RecentProjects}">
          <MenuItem.ItemContainerStyle>
            <Style
                BasedOn="{StaticResource {x:Type MenuItem}}"
                TargetType="MenuItem">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="ToolTip" Value="{Binding ProjectPath}" />
              <EventSetter Event="Click" Handler="RecentProject_Click" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click" />
        <MenuItem Header="Save _All" InputGestureText="Ctrl+Shift+S" Click="SaveAll_Click" />
        <MenuItem Header="Close _Document" Click="CloseDocument_Click" />
        <MenuItem Header="Close Pro_ject" Click="CloseProject_Click" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="_Build">
        <MenuItem Header="_Build Project" InputGestureText="Ctrl+B" Click="Build_Click" />
        <MenuItem Header="Build _Workspace" Click="BuildWorkspace_Click" />
        <MenuItem Header="Build _Release Package" Click="Release_Click" />
        <Separator />
        <MenuItem Header="Publishing _Metadata..." Click="PublishingMetadata_Click" />
        <MenuItem Header="_Validate Publishing" Click="ValidatePublishing_Click" />
        <MenuItem Header="_Publish Release" Click="Publish_Click" />
        <MenuItem Header="_Test Explorer..." InputGestureText="Ctrl+T" Click="TestExplorer_Click" />
        <Separator />
        <MenuItem Header="Streamer.bot _Designer..." Click="StreamerBotDesigner_Click" />
        <MenuItem Header="OBS Plugin D_esigner..." Click="ObsPluginDesigner_Click" />
        <MenuItem Header="_Package Viewer..." Click="PackageViewer_Click" />
        <Separator />
        <MenuItem Header="_Deploy / Manage Installation..." Click="Deployment_Click" />
      </MenuItem>
      <MenuItem Header="_Code">
        <MenuItem
            Header="_Format Document"
            InputGestureText="Ctrl+Alt+F"
            Click="FormatDocument_Click" />
        <MenuItem
            Header="Go to _Definition"
            InputGestureText="F12"
            ToolTip="Place the caret on a symbol and press F12." />
        <Separator />
        <MenuItem
            Header="Snippet _Browser..."
            InputGestureText="Ctrl+Shift+I"
            Click="SnippetBrowser_Click" />
        <MenuItem
            Header="CPH Method _Reference…"
            Click="CphReference_Click" />
        <MenuItem
            Header="OBS Native API _Reference..."
            Click="ObsApiReference_Click" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="Reusable _Components..." Click="ReusableComponents_Click" />
        <MenuItem Header="Migrate Legacy _Project..." Click="MigrateProject_Click" />
        <MenuItem Header="_Settings…" InputGestureText="Ctrl+," Click="Settings_Click" />
        <MenuItem Header="Development _Toolchain..." Click="ObsSdkManager_Click" />
        <MenuItem Header="_Run Setup Checks..." Click="RunSetup_Click" />
        <MenuItem Header="_Recovery and Diagnostics..." Click="RecoveryDiagnostics_Click" />
        <MenuItem Header="_Reset Layout" Click="ResetLayout_Click" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for _Updates..." Click="CheckUpdates_Click" />
        <MenuItem Header="_Privacy and Offline Use" Click="Privacy_Click" />
        <Separator />
        <MenuItem Header="_About" Click="About_Click" />
      </MenuItem>
    </Menu>

    <Border
        Grid.Row="1"
        Padding="7,4"
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource PanelBorderBrush}"
        BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Image
              Width="30"
              Height="30"
              Margin="2,0,8,0"
              AutomationProperties.Name="Creators Forge logo"
              Source="{DynamicResource CreatorForgeLogoImage}"
              Stretch="Uniform" />
          <TextBlock
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AccentBrush}"
              Text="FOUNDRY" />
          <Button Content="New" Click="NewProject_Click" />
          <Button Content="Open" Click="OpenProject_Click" />
          <Button Content="Save" Click="Save_Click" />
          <Button Content="Format" Click="FormatDocument_Click" />
          <Button Content="Snippets" Click="SnippetBrowser_Click" />
          <Button Content="Build" Click="Build_Click" />
          <Button Content="Test" Click="TestExplorer_Click" />
        </StackPanel>
        <StackPanel
            DockPanel.Dock="Right"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
          <TextBlock
              Margin="12,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource MutedTextBrush}"
              Text="{Binding TargetSummary}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ProjectColumn" Width="280" MinWidth="180" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="180" />
      </Grid.ColumnDefinitions>

      <Border
          Grid.Column="0"
          Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="0,0,1,0">
        <DockPanel>
          <Border
              DockPanel.Dock="Top"
              Padding="10,8"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left">
                <TextBlock FontWeight="SemiBold" Text="SOLUTION EXPLORER" />
                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="{Binding ProjectName}" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="42"
                    Padding="6,3"
                    AutomationProperties.Name="Add project item"
                    Content="Add"
                    Click="AddProjectItem_Click" />
                <Button
                    MinWidth="28"
                    Padding="6,3"
                    AutomationProperties.Name="Refresh project files"
                    Content="↻"
                    ToolTip="Refresh project files"
                    Click="RefreshProjectTree_Click" />
              </StackPanel>
            </DockPanel>
          </Border>
          <TreeView
              x:Name="ProjectTree"
              AutomationProperties.Name="Project files"
              Padding="7"
              ItemsSource="{Binding ProjectItems}"
              PreviewMouseRightButtonDown="ProjectTree_PreviewMouseRightButtonDown"
              MouseDoubleClick="ProjectTree_MouseDoubleClick">
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="_Add New Item…" Click="AddProjectItem_Click" />
                <MenuItem Header="_Refresh" Click="RefreshProjectTree_Click" />
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          Background="{DynamicResource PanelBorderBrush}"
          ResizeBehavior="PreviousAndNext"
          ResizeDirection="Columns" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="5" />
          <RowDefinition x:Name="BottomRow" Height="230" MinHeight="120" />
        </Grid.RowDefinitions>

        <TabControl
            x:Name="DocumentTabs"
            AutomationProperties.Name="Open documents"
            Grid.Row="0"
            ItemsSource="{Binding Documents}"
            SelectedItem="{Binding SelectedDocument}">
          <TabControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Margin="8,2" Text="{Binding Title}" />
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate>
              <local:CodeEditor
                  DefinitionRequested="CodeEditor_DefinitionRequested"
                  FormatRequested="CodeEditor_FormatRequested" />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>

        <GridSplitter
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource PanelBorderBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows" />

        <TabControl Grid.Row="2">
          <TabItem Header="Problems">
            <ListBox
                x:Name="ProblemsList"
                AutomationProperties.Name="Problems and diagnostics"
                ItemsSource="{Binding Problems}"
                MouseDoubleClick="ProblemsList_MouseDoubleClick">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="ToolTip" Value="{Binding Location.FilePath}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="6,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="75" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Foreground="{DynamicResource AccentBrush}"
                        Text="{Binding Severity}" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Code}" />
                    <TextBlock
                        Grid.Column="2"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="{Binding Location.Line, StringFormat=Line {0}}" />
                    <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
          <TabItem Header="Build">
            <TextBox
                Padding="10"
                FontFamily="Cascadia Mono, Consolas"
                IsReadOnly="True"
                Text="{Binding BuildLog, Mode=OneWay}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
          </TabItem>
          <TabItem Header="Console">
            <TextBox
                Padding="10"
                FontFamily="Cascadia Mono, Consolas"
                IsReadOnly="True"
                Text="{Binding ConsoleLog, Mode=OneWay}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter
          Grid.Column="3"
          HorizontalAlignment="Stretch"
          Background="{DynamicResource PanelBorderBrush}"
          ResizeBehavior="PreviousAndNext"
          ResizeDirection="Columns" />

      <Border
          Grid.Column="4"
          Padding="12"
          Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1,0,0,0">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="INSPECTOR" />
          <Separator Margin="0,10" />
          <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Selection" />
          <TextBlock
              Margin="0,4,0,14"
              FontWeight="SemiBold"
              Text="{Binding SelectedDocument.FileName, TargetNullValue=No document selected}" />
          <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Project path" />
          <TextBlock
              Margin="0,4,0,14"
              Text="{Binding SelectedDocument.RelativePath, TargetNullValue=—}"
              TextWrapping="Wrap" />
          <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Target" />
          <TextBlock Margin="0,4,0,14" Text="{Binding TargetSummary}" TextWrapping="Wrap" />
          <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Recovery" />
          <TextBlock
              Margin="0,4"
              Text="Dirty documents are copied to local recovery storage on the autosave interval."
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <StatusBar
        Grid.Row="3"
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource PanelBorderBrush}"
        BorderThickness="0,1,0,0">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding TargetSummary}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
