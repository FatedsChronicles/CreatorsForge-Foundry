<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CreatorsForge.Foundry.App"
    Title="{Binding WindowTitle}"
    MinWidth="900"
    MinHeight="600"
    Closing="Window_Closing"
    AutomationProperties.Name="Creators Forge Foundry workspace">
  <Window.Resources>
    <HierarchicalDataTemplate
        DataType="{x:Type local:ProjectTreeItemViewModel}"
        ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal">
        <Border
            Width="35"
            Height="18"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Background="{DynamicResource ButtonBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="2">
          <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontFamily="Consolas"
              FontSize="9"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AccentBrush}"
              Text="{Binding IconLabel}" />
        </Border>
        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
      </StackPanel>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project…" InputGestureText="Ctrl+N" Click="NewProject_Click" />
        <MenuItem Header="_Open Project…" InputGestureText="Ctrl+O" Click="OpenProject_Click" />
        <MenuItem Header="_Adopt Existing Folder…" Click="AdoptExistingFolder_Click" />
        <MenuItem Header="New _Workspace..." Click="NewWorkspace_Click" />
        <MenuItem Header="Open W_orkspace..." Click="OpenWorkspace_Click" />
        <MenuItem Header="_Add Project to Workspace..." Click="AddProjectToWorkspace_Click" />
        <Separator />
        <MenuItem Header="_Import Project Template..." Click="ImportProjectTemplate_Click" />
        <MenuItem Header="_Export Project Template..." Click="ExportProjectTemplate_Click" />
        <MenuItem Header="_Recent Projects" ItemsSource="{Binding RecentProjects}">
          <MenuItem.ItemContainerStyle>
            <Style
                BasedOn="{StaticResource {x:Type MenuItem}}"
                TargetType="MenuItem">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="ToolTip" Value="{Binding ProjectPath}" />
              <EventSetter Event="Click" Handler="RecentProject_Click" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click" />
        <MenuItem Header="Save _All" InputGestureText="Ctrl+Shift+S" Click="SaveAll_Click" />
        <MenuItem Header="Close _Document" Click="CloseDocument_Click" />
        <MenuItem Header="Close Pro_ject" Click="CloseProject_Click" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="_Build">
        <MenuItem Header="_Build Project" InputGestureText="Ctrl+B" Click="Build_Click" />
        <MenuItem Header="Build _Workspace" Click="BuildWorkspace_Click" />
        <MenuItem Header="Build _Release Package" Click="Release_Click" />
        <Separator />
        <MenuItem Header="Publishing _Metadata..." Click="PublishingMetadata_Click" />
        <MenuItem Header="_Validate Publishing" Click="ValidatePublishing_Click" />
        <MenuItem Header="_Publish Release" Click="Publish_Click" />
        <MenuItem Header="_Test Explorer..." InputGestureText="Ctrl+Shift+T" Click="TestExplorer_Click" />
        <Separator />
        <MenuItem Header="Streamer.bot _Designer..." Click="StreamerBotDesigner_Click" />
        <MenuItem Header="OBS Plugin D_esigner..." Click="ObsPluginDesigner_Click" />
        <MenuItem Header="_Package Viewer..." Click="PackageViewer_Click" />
        <Separator />
        <MenuItem Header="_Deploy / Manage Installation..." Click="Deployment_Click" />
      </MenuItem>
      <MenuItem Header="_Code">
        <MenuItem
            Header="_Format Document"
            InputGestureText="Ctrl+Alt+F"
            Click="FormatDocument_Click" />
        <MenuItem
            Header="Go to _Definition"
            InputGestureText="F12"
            ToolTip="Place the caret on a symbol and press F12." />
        <Separator />
        <MenuItem
            Header="Snippet _Browser..."
            InputGestureText="Ctrl+Shift+I"
            Click="SnippetBrowser_Click" />
        <MenuItem
            Header="CPH Method _Reference…"
            Click="CphReference_Click" />
        <MenuItem
            Header="OBS Native API _Reference..."
            Click="ObsApiReference_Click" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Design _Preview..." InputGestureText="Ctrl+Shift+P" Click="PreviewDesigner_Click" />
        <MenuItem Header="Integrated _Terminal" InputGestureText="Ctrl+T" Click="ToggleTerminal_Click" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="Reusable _Components..." Click="ReusableComponents_Click" />
        <MenuItem Header="Migrate Legacy _Project..." Click="MigrateProject_Click" />
        <MenuItem Header="_Settings…" InputGestureText="Ctrl+," Click="Settings_Click" />
        <MenuItem Header="Development _Toolchain..." Click="ObsSdkManager_Click" />
        <MenuItem Header="_Run Setup Checks..." Click="RunSetup_Click" />
        <MenuItem Header="_Recovery and Diagnostics..." Click="RecoveryDiagnostics_Click" />
        <MenuItem Header="_Reset Layout" Click="ResetLayout_Click" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for _Updates..." Click="CheckUpdates_Click" />
        <MenuItem Header="_Privacy and Offline Use" Click="Privacy_Click" />
        <Separator />
        <MenuItem Header="_About" Click="About_Click" />
      </MenuItem>
    </Menu>

    <Border
        Grid.Row="1"
        Padding="7,4"
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource PanelBorderBrush}"
        BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Image
              Width="30"
              Height="30"
              Margin="2,0,8,0"
              AutomationProperties.Name="Creators Forge logo"
              Source="{DynamicResource CreatorForgeLogoImage}"
              Stretch="Uniform" />
          <TextBlock
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AccentBrush}"
              Text="FOUNDRY" />
          <Button Content="New" Click="NewProject_Click" />
          <Button Content="Open" Click="OpenProject_Click" />
          <Button Content="Save" Click="Save_Click" />
          <Button Content="Format" Click="FormatDocument_Click" />
          <Button Content="Snippets" Click="SnippetBrowser_Click" />
          <Button Content="Build" Click="Build_Click" />
          <Button Content="Test" Click="TestExplorer_Click" />
          <Button Content="Preview" Click="PreviewDesigner_Click" />
        </StackPanel>
        <StackPanel
            DockPanel.Dock="Right"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
          <TextBlock
              Margin="12,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource MutedTextBrush}"
              Text="{Binding TargetSummary}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ProjectColumn" Width="280" MinWidth="180" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="180" />
      </Grid.ColumnDefinitions>

      <Border
          Grid.Column="0"
          Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="0,0,1,0">
        <DockPanel>
          <Border
              DockPanel.Dock="Top"
              Padding="10,8"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left">
                <TextBlock FontWeight="SemiBold" Text="SOLUTION EXPLORER" />
                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="{Binding ProjectName}" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="42"
                    Padding="6,3"
                    AutomationProperties.Name="Add project item"
                    Content="Add"
                    Click="AddProjectItem_Click" />
                <Button
                    MinWidth="28"
                    Padding="6,3"
                    AutomationProperties.Name="Refresh project files"
                    Content="↻"
                    ToolTip="Refresh project files"
                    Click="RefreshProjectTree_Click" />
              </StackPanel>
            </DockPanel>
          </Border>
          <TreeView
              x:Name="ProjectTree"
              AllowDrop="True"
              AutomationProperties.Name="Project files"
              Padding="7"
              ItemsSource="{Binding ProjectItems}"
              DragOver="ProjectTree_DragOver"
              Drop="ProjectTree_Drop"
              PreviewKeyDown="ProjectTree_PreviewKeyDown"
              PreviewMouseLeftButtonDown="ProjectTree_PreviewMouseLeftButtonDown"
              PreviewMouseMove="ProjectTree_PreviewMouseMove"
              PreviewMouseRightButtonDown="ProjectTree_PreviewMouseRightButtonDown"
              MouseDoubleClick="ProjectTree_MouseDoubleClick">
            <TreeView.ContextMenu>
              <ContextMenu>
                <ContextMenu.Resources>
                  <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                          <Border
                              x:Name="ItemBorder"
                              Padding="{TemplateBinding Padding}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="Transparent"
                              BorderThickness="1"
                              CornerRadius="3"
                              SnapsToDevicePixels="True">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                              <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuSelectionBrush}" />
                              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                              <Setter TargetName="ItemBorder" Property="Opacity" Value="0.62" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                  <Style TargetType="Separator">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="8,5" />
                    <Setter Property="Opacity" Value="0.65" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                          <Border
                              Height="1"
                              Background="{DynamicResource PanelBorderBrush}"
                              SnapsToDevicePixels="True" />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ContextMenu.Resources>
                <MenuItem Header="_Add New Item…" Click="AddProjectItem_Click" />
                <Separator />
                <MenuItem Header="_Rename…" Click="RenameProjectItem_Click" />
                <MenuItem Header="_Delete" Click="RecycleProjectItem_Click" />
                <Separator />
                <MenuItem Header="Show in File _Explorer" Click="RevealProjectItem_Click" />
                <MenuItem Header="Copy _Relative Path" Click="CopyProjectItemPath_Click" />
                <MenuItem Header="Copy _Full Path" Click="CopyProjectItemFullPath_Click" />
                <Separator />
                <MenuItem Header="_Refresh" Click="RefreshProjectTree_Click" />
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          Background="{DynamicResource PanelBorderBrush}"
          ResizeBehavior="PreviousAndNext"
          ResizeDirection="Columns" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="5" />
          <RowDefinition x:Name="BottomRow" Height="230" MinHeight="120" />
        </Grid.RowDefinitions>

        <TabControl
            x:Name="DocumentTabs"
            AutomationProperties.Name="Open documents"
            Grid.Row="0"
            ItemsSource="{Binding Documents}"
            SelectedItem="{Binding SelectedDocument}">
          <TabControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="8,2" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                <Button
                    Width="18"
                    Height="18"
                    MinWidth="0"
                    Margin="6,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding FileName, StringFormat=Close {0}}"
                    Content="×"
                    Focusable="False"
                    ToolTip="Close document"
                    Click="CloseDocumentTab_Click" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate>
              <local:CodeEditor
                  DefinitionRequested="CodeEditor_DefinitionRequested"
                  FormatRequested="CodeEditor_FormatRequested" />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>

        <GridSplitter
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource PanelBorderBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows" />

        <TabControl x:Name="BottomTabs" Grid.Row="2">
          <TabItem Header="Problems">
            <ListBox
                x:Name="ProblemsList"
                AutomationProperties.Name="Problems and diagnostics"
                ItemsSource="{Binding Problems}"
                MouseDoubleClick="ProblemsList_MouseDoubleClick">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="ToolTip" Value="{Binding Location.FilePath}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="6,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="75" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Foreground="{DynamicResource AccentBrush}"
                        Text="{Binding Severity}" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Code}" />
                    <TextBlock
                        Grid.Column="2"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="{Binding Location.Line, StringFormat=Line {0}}" />
                    <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
          <TabItem Header="Build">
            <TextBox
                Padding="10"
                FontFamily="Cascadia Mono, Consolas"
                IsReadOnly="True"
                Text="{Binding BuildLog, Mode=OneWay}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
          </TabItem>
          <TabItem Header="Console">
            <TextBox
                Padding="10"
                FontFamily="Cascadia Mono, Consolas"
                IsReadOnly="True"
                Text="{Binding ConsoleLog, Mode=OneWay}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
          </TabItem>
          <TabItem x:Name="TerminalTab" Header="Terminal">
            <Grid AutomationProperties.Name="Integrated PowerShell terminal">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border
                  Grid.Row="0"
                  Padding="8,5"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="0,0,0,1">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        x:Name="StartTerminalButton"
                        MinWidth="58"
                        Content="Start"
                        Click="StartTerminal_Click" />
                    <Button
                        x:Name="StopTerminalButton"
                        MinWidth="58"
                        Content="Stop"
                        Click="StopTerminal_Click" />
                    <Button
                        x:Name="RestartTerminalButton"
                        MinWidth="64"
                        Content="Restart"
                        Click="RestartTerminal_Click" />
                    <Button
                        MinWidth="58"
                        Content="Clear"
                        Click="ClearTerminal_Click" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock
                        x:Name="TerminalStatus"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBrush}"
                        Text="STOPPED" />
                    <TextBlock
                        x:Name="TerminalWorkingDirectory"
                        Margin="0,2,12,0"
                        FontSize="11"
                        Foreground="{DynamicResource MutedTextBrush}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="Terminal working directory" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <TextBox
                  x:Name="TerminalOutput"
                  Grid.Row="1"
                  Padding="10"
                  AutomationProperties.LiveSetting="Polite"
                  AutomationProperties.Name="PowerShell output"
                  FontFamily="Cascadia Mono, Consolas"
                  IsReadOnly="True"
                  TextWrapping="Wrap"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto" />
              <Border
                  Grid.Row="2"
                  Padding="8,5"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="0,1,0,0">
                <DockPanel>
                  <TextBlock
                      DockPanel.Dock="Left"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      FontFamily="Cascadia Mono, Consolas"
                      Foreground="{DynamicResource AccentBrush}"
                      Text="PS&gt;" />
                  <TextBox
                      x:Name="TerminalInput"
                      AutomationProperties.HelpText="Press Enter to run the PowerShell command. Use Up and Down for command history."
                      AutomationProperties.Name="PowerShell command"
                      FontFamily="Cascadia Mono, Consolas"
                      PreviewKeyDown="TerminalInput_KeyDown"
                      SpellCheck.IsEnabled="False" />
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter
          Grid.Column="3"
          HorizontalAlignment="Stretch"
          Background="{DynamicResource PanelBorderBrush}"
          ResizeBehavior="PreviousAndNext"
          ResizeDirection="Columns" />

      <Border
          Grid.Column="4"
          Padding="12"
          Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1,0,0,0">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="INSPECTOR" />
          <Separator Margin="0,10" />
          <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Selection" />
          <TextBlock
              Margin="0,4,0,14"
              FontWeight="SemiBold"
              Text="{Binding SelectedDocument.FileName, TargetNullValue=No document selected}" />
          <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Project path" />
          <TextBlock
              Margin="0,4,0,14"
              Text="{Binding SelectedDocument.RelativePath, TargetNullValue=—}"
              TextWrapping="Wrap" />
          <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Target" />
          <TextBlock Margin="0,4,0,14" Text="{Binding TargetSummary}" TextWrapping="Wrap" />
          <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Recovery" />
          <TextBlock
              Margin="0,4"
              Text="Dirty documents are copied to local recovery storage on the autosave interval."
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <StatusBar
        Grid.Row="3"
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource PanelBorderBrush}"
        BorderThickness="0,1,0,0">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding TargetSummary}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
