<Window Style="{StaticResource FoundryWindowStyle}" x:Class="CreatorsForge.Foundry.App.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Creators Forge Foundry Settings" Width="680" Height="520" MinWidth="600" MinHeight="460"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner" AutomationProperties.Name="Foundry settings">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Margin="0,0,0,18" FontSize="20" FontWeight="SemiBold" Text="Application settings" />
    <TabControl Grid.Row="1" AutomationProperties.Name="Settings categories">
      <TabItem Header="Workspace"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Center" Text="Default project folder"/><TextBox x:Name="ProjectDirectoryTextBox" Grid.Column="1" Margin="6" Padding="7" AutomationProperties.Name="Default project folder"/><Button Grid.Column="2" Content="Browse…" Click="Browse_Click"/>
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Recovery autosave"/><StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="6" Orientation="Horizontal"><TextBox x:Name="AutosaveTextBox" Width="80" Padding="7" AutomationProperties.Name="Recovery autosave seconds"/><TextBlock Margin="8,0" VerticalAlignment="Center" Text="seconds (10–600)"/></StackPanel>
        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="6,12" Foreground="{DynamicResource MutedTextBrush}" Text="Layout dimensions are saved automatically. Use Tools → Reset Layout to restore defaults." TextWrapping="Wrap"/>
      </Grid></TabItem>
      <TabItem Header="Appearance"><StackPanel Margin="14">
        <TextBlock FontWeight="SemiBold" Text="Application theme" />
        <ComboBox x:Name="ThemeComboBox" Width="220" Margin="0,8,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Application theme">
          <ComboBoxItem Content="System" ToolTip="Follow the Windows app theme." />
          <ComboBoxItem Content="Dark" />
          <ComboBoxItem Content="Light" />
        </ComboBox>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="Theme changes apply immediately after Save. Windows High Contrast always takes priority so system accessibility colours remain intact." />
      </StackPanel></TabItem>
      <TabItem Header="Updates"><StackPanel Margin="14">
        <TextBlock FontWeight="SemiBold" Text="Update manifest location"/><TextBox x:Name="UpdateLocationTextBox" Margin="0,6,0,12" Padding="7" AutomationProperties.Name="Update manifest location"/>
        <CheckBox x:Name="NetworkAccessCheckBox" Content="Allow explicit HTTPS update checks and SDK downloads"/>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="Leave the location empty to disable update checks. A local manifest path works without network access. Foundry never checks automatically."/>
      </StackPanel></TabItem>
      <TabItem Header="Privacy"><StackPanel Margin="14">
        <TextBlock TextWrapping="Wrap" Text="Foundry includes no telemetry. Projects, settings, build output, recovery snapshots, and failure reports remain on this computer. Diagnostic bundles are created only when requested and are never uploaded by Foundry."/>
        <CheckBox x:Name="IncludePathsCheckBox" Margin="0,16,0,0" Content="Include local file paths in diagnostic bundles"/>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="Keep this disabled when sharing a bundle publicly. Always review a bundle before sending it."/>
      </StackPanel></TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button MinWidth="90" Content="Cancel" IsCancel="True"/><Button MinWidth="90" Content="Save" IsDefault="True" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
