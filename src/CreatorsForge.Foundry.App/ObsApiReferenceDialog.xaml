<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.ObsApiReferenceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OBS Native API Reference"
    Width="1050"
    Height="720"
    MinWidth="780"
    MinHeight="520"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="350" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Pinned libobs catalogue" />
      <TextBlock x:Name="ProfileText" Margin="0,3,0,8" Foreground="{DynamicResource MutedTextBrush}" />
      <TextBox
          x:Name="SearchTextBox"
          Padding="8"
          TextChanged="SearchTextBox_TextChanged"
          ToolTip="Filter by symbol, category, header, or description" />
    </StackPanel>

    <ListBox
        x:Name="SymbolsList"
        Grid.Row="1"
        Grid.Column="0"
        Margin="0,8,0,0"
        DisplayMemberPath="Name"
        SelectionChanged="SymbolsList_SelectionChanged" />

    <GridSplitter
        Grid.RowSpan="2"
        Grid.Column="1"
        HorizontalAlignment="Stretch"
        Background="{DynamicResource PanelBorderBrush}"
        ResizeDirection="Columns" />

    <TextBox
        x:Name="DetailsTextBox"
        Grid.RowSpan="2"
        Grid.Column="2"
        Margin="8,0,0,0"
        Padding="14"
        FontFamily="Cascadia Mono, Consolas"
        IsReadOnly="True"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto" />

    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <TextBlock x:Name="RevisionText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
      <Button MinWidth="90" HorizontalAlignment="Right" Content="Close" IsCancel="True" />
    </DockPanel>
  </Grid>
</Window>
