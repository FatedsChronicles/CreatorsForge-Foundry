<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.StreamerBotImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Import Streamer.bot Code"
    Width="900" Height="760" MinWidth="760" MinHeight="620"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Import Streamer.bot code into a new project"/>
        <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
            Text="Foundry decodes and analyzes the package without executing imported C#, scripts, DLLs, or sub-actions."/>
      </StackPanel>
      <Button DockPanel.Dock="Right" MinWidth="120" Content="Load from file..." Click="LoadFile_Click"/>
    </DockPanel>
    <TextBox x:Name="ImportCodeText" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap"
        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
        FontFamily="Consolas" AutomationProperties.Name="Streamer.bot import code"/>
    <StackPanel Grid.Row="2" Margin="0,8" Orientation="Horizontal">
      <Button MinWidth="110" Content="Analyze safely" Click="Analyze_Click"/>
      <TextBlock x:Name="AnalysisStatusText" Margin="12,7,0,0" Text="Paste code or load an export file."/>
    </StackPanel>
    <TextBox x:Name="AnalysisText" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Project name"/><TextBox x:Name="NameText" Grid.Column="1" Margin="5"/>
      <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Package ID"/><TextBox x:Name="IdText" Grid.Column="3" Grid.ColumnSpan="2" Margin="5"/>
      <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="New folder"/><TextBox x:Name="DestinationText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="5"/>
      <Button Grid.Row="1" Grid.Column="4" Content="Browse..." Click="BrowseDestination_Click"/>
      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Version"/><TextBox x:Name="VersionText" Grid.Row="2" Grid.Column="1" Margin="5" Text="1.1.0-beta.1"/>
      <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="Author"/><TextBox x:Name="AuthorText" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Margin="5"/>
      <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Profile"/><ComboBox x:Name="ProfileCombo" Grid.Row="3" Grid.Column="1" Margin="5"/>
      <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="Attribution"/><TextBox x:Name="AttributionText" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Margin="5"/>
    </Grid>
    <DockPanel Grid.Row="5" Margin="0,12,0,0">
      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
          Text="No licence is assigned. Publishing stays blocked until you provide an authorised licence."/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button MinWidth="90" Content="Cancel" IsCancel="True"/>
        <Button x:Name="CreateButton" MinWidth="120" Content="Create project" IsDefault="True" IsEnabled="False" Click="Create_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
