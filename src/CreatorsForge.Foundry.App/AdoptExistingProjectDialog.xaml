<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.AdoptExistingProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Adopt Existing Project"
    Width="720"
    Height="700"
    MinWidth="620"
    MinHeight="520"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="145" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Adopt existing source folder" />
      <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}"
          Text="Foundry will create one .foundryproj sidecar. Existing files and folders will not be moved, rewritten, or deleted."
          TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Source folder" />
    <TextBox x:Name="FolderTextBox" Grid.Row="1" Grid.Column="1" Margin="6" Padding="7" IsReadOnly="True" />
    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Project name" />
    <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1" Margin="6" Padding="7" />
    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Project ID" />
    <TextBox x:Name="IdTextBox" Grid.Row="3" Grid.Column="1" Margin="6" Padding="7" />
    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Target" />
    <ComboBox x:Name="ProviderComboBox" Grid.Row="4" Grid.Column="1" Margin="6" Padding="7"
        SelectionChanged="Provider_SelectionChanged">
      <ComboBoxItem Content="Streamer.bot managed extension" Tag="streamerbot" />
      <ComboBoxItem Content="OBS Studio native plugin" Tag="obsstudio" />
    </ComboBox>
    <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Compatibility profile" />
    <ComboBox x:Name="ProfileComboBox" Grid.Row="5" Grid.Column="1" Margin="6" Padding="7" />
    <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Author" />
    <TextBox x:Name="AuthorTextBox" Grid.Row="6" Grid.Column="1" Margin="6" Padding="7" Text="Creator" />

    <Grid Grid.Row="7" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
      <ListBox x:Name="PreviewList" Grid.Row="1" Margin="0,8,0,8" />
      <TextBlock x:Name="SafetyText" Grid.Row="2" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
    </Grid>

    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="90" Content="Cancel" IsCancel="True" />
      <Button x:Name="AdoptButton" MinWidth="90" Content="Adopt" IsDefault="True" Click="Adopt_Click" />
    </StackPanel>
  </Grid>
</Window>
