<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.PublishingMetadataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Publishing Metadata"
    Width="820"
    Height="740"
    MinWidth="680"
    MinHeight="560"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Publishing and distribution" />
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Describe the release, record its dependencies, and optionally sign Windows DLLs." />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="0,0,10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,6" VerticalAlignment="Center" Text="Version" />
        <DockPanel Grid.Row="0" Grid.Column="1">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Patch" Click="Patch_Click" /><Button Content="Minor" Click="Minor_Click" /><Button Content="Major" Click="Major_Click" />
          </StackPanel>
          <TextBox x:Name="VersionText" Margin="0,2,8,2" />
        </DockPanel>
        <TextBlock Grid.Row="1" Margin="0,6" VerticalAlignment="Center" Text="Package name" />
        <TextBox x:Name="PackageNameText" Grid.Row="1" Grid.Column="1" Margin="0,2" />
        <TextBlock Grid.Row="2" Margin="0,6" VerticalAlignment="Center" Text="Summary" />
        <TextBox x:Name="SummaryText" Grid.Row="2" Grid.Column="1" Margin="0,2" />
        <TextBlock Grid.Row="3" Margin="0,6" VerticalAlignment="Center" Text="Authors" />
        <TextBox x:Name="AuthorsText" Grid.Row="3" Grid.Column="1" Margin="0,2" ToolTip="Separate multiple authors with commas." />
        <TextBlock Grid.Row="4" Margin="0,6" VerticalAlignment="Center" Text="Licence file" />
        <TextBox x:Name="LicenseText" Grid.Row="4" Grid.Column="1" Margin="0,2" />
        <TextBlock Grid.Row="5" Margin="0,6" VerticalAlignment="Center" Text="Changelog file" />
        <TextBox x:Name="ChangelogText" Grid.Row="5" Grid.Column="1" Margin="0,2" />
        <TextBlock Grid.Row="6" Margin="0,6" VerticalAlignment="Center" Text="Homepage" />
        <TextBox x:Name="HomepageText" Grid.Row="6" Grid.Column="1" Margin="0,2" />
        <TextBlock Grid.Row="7" Margin="0,6" VerticalAlignment="Center" Text="Repository" />
        <TextBox x:Name="RepositoryText" Grid.Row="7" Grid.Column="1" Margin="0,2" />
        <TextBlock Grid.Row="8" Margin="0,6" VerticalAlignment="Center" Text="Tags" />
        <TextBox x:Name="TagsText" Grid.Row="8" Grid.Column="1" Margin="0,2" ToolTip="Separate tags with commas." />
        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,14,0,4">
          <TextBlock FontWeight="SemiBold" Text="Dependency inventory" />
          <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="One dependency per line: kind | name | version | licence | source" />
        </StackPanel>
        <TextBox x:Name="DependenciesText" Grid.Row="10" Grid.ColumnSpan="2" Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
        <CheckBox x:Name="SigningEnabled" Grid.Row="11" Grid.ColumnSpan="2" Margin="0,14,0,4" FontWeight="SemiBold" Content="Sign Windows DLLs during publishing" Checked="SigningChanged" Unchecked="SigningChanged" />
        <TextBlock Grid.Row="12" Margin="0,6" VerticalAlignment="Center" Text="Signing tool" />
        <TextBox x:Name="SigningToolText" Grid.Row="12" Grid.Column="1" Margin="0,2" />
        <TextBlock Grid.Row="13" Margin="0,6" VerticalAlignment="Center" Text="Certificate thumbprint" />
        <TextBox x:Name="ThumbprintText" Grid.Row="13" Grid.Column="1" Margin="0,2" />
        <TextBlock Grid.Row="14" Margin="0,6" VerticalAlignment="Center" Text="Timestamp URL" />
        <TextBox x:Name="TimestampText" Grid.Row="14" Grid.Column="1" Margin="0,2" />
        <TextBlock Grid.Row="15" Grid.ColumnSpan="2" Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="Publishing validation requires a non-empty licence, a changelog entry containing the exact version, and a successful provider build." />
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="90" Content="Cancel" IsCancel="True" />
      <Button MinWidth="110" Content="Save" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
