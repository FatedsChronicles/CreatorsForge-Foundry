<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.NewProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create Foundry Project"
    Width="560"
    Height="640"
    MinWidth="500"
    MinHeight="340"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="125" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <TextBlock
        Grid.Row="0"
        Grid.ColumnSpan="3"
        Margin="0,0,0,18"
        FontSize="20"
        FontWeight="SemiBold"
        Text="New Foundry project" />

    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Project name" />
    <TextBox
        x:Name="ProjectNameTextBox"
        Grid.Row="1"
        Grid.Column="1"
        Grid.ColumnSpan="2"
        Margin="6"
        Padding="7"
        Text="My Extension" />

    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Project ID" />
    <TextBox
        x:Name="ProjectIdTextBox"
        Grid.Row="2"
        Grid.Column="1"
        Grid.ColumnSpan="2"
        Margin="6"
        Padding="7"
        Text="com.example.my-extension" />

    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Parent folder" />
    <TextBox
        x:Name="ProjectLocationTextBox"
        Grid.Row="3"
        Grid.Column="1"
        Margin="6"
        Padding="7" />
    <Button
        Grid.Row="3"
        Grid.Column="2"
        Content="Browse…"
        Click="Browse_Click" />

    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Project type" />
    <ComboBox
        x:Name="TargetProviderComboBox"
        Grid.Row="4"
        Grid.Column="1"
        Grid.ColumnSpan="2"
        Margin="6"
        Padding="7"
        SelectedIndex="0"
        SelectionChanged="TargetProvider_SelectionChanged">
      <ComboBoxItem Content="Streamer.bot extension" Tag="streamerbot" />
      <ComboBoxItem Content="OBS Studio native plugin" Tag="obsstudio" />
    </ComboBox>

    <StackPanel
        Grid.Row="5"
        Grid.Column="1"
        Grid.ColumnSpan="2"
        Margin="6,10,6,0">
      <TextBlock Text="Compatibility profile" />
      <ComboBox
          x:Name="ProfileComboBox"
          Margin="0,6,0,0"
          Padding="7"
          SelectedIndex="0">
        <ComboBoxItem Content="1.0.4-stable" />
        <ComboBoxItem Content="1.0.5-alpha.34" />
        <ComboBoxItem Content="1.0.5-beta.1" />
        <ComboBoxItem Content="1.0.5-beta.6" />
      </ComboBox>
      <TextBlock Margin="0,12,0,0" Text="Project template" />
      <ComboBox
          x:Name="TemplateComboBox"
          Margin="0,6,0,0"
          Padding="7"
          DisplayMemberPath="Name"
          SelectedValuePath="Id"
          SelectionChanged="Template_SelectionChanged" />
      <TextBlock Margin="0,12,0,0" Text="Author" />
      <TextBox x:Name="AuthorTextBox" Margin="0,6,0,0" Padding="7" Text="Creator" />
      <TextBlock Margin="0,12,0,0" Text="Description" />
      <TextBox
          x:Name="DescriptionTextBox"
          Height="58"
          Margin="0,6,0,0"
          Padding="7"
          AcceptsReturn="True"
          TextWrapping="Wrap" />
      <TextBlock
          x:Name="ProjectTypeDescriptionText"
          Margin="0,10,0,0"
          Foreground="{DynamicResource MutedTextBrush}"
          Text="Foundry creates a managed library, args-log-v1 CPHInline bridge, structured Streamer.bot definition, and stable-v23 import package."
          TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel
        Grid.Row="6"
        Grid.ColumnSpan="3"
        Margin="0,18,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
      <Button MinWidth="90" Content="Cancel" IsCancel="True" />
      <Button MinWidth="90" Content="Create" IsDefault="True" Click="Create_Click" />
    </StackPanel>
  </Grid>
</Window>
