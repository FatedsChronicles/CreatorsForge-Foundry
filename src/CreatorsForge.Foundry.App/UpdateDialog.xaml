<Window Style="{StaticResource FoundryWindowStyle}" x:Class="CreatorsForge.Foundry.App.UpdateDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Foundry Updates" Width="660" Height="420" MinWidth="560" MinHeight="340" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Application updates" />
    <TextBlock Grid.Row="1" Margin="0,6,0,12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="Update checks are manual. Local manifests work offline; HTTPS is used only when network access is enabled in Settings." />
    <TextBox x:Name="OutputText" Grid.Row="2" Padding="10" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Update status" />
    <StackPanel Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="DownloadButton" MinWidth="150" Content="Stage Verified Update" IsEnabled="False" Click="Download_Click"/>
      <Button MinWidth="120" Content="Check for Updates" IsDefault="True" Click="Check_Click"/>
      <Button MinWidth="90" Content="Close" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
