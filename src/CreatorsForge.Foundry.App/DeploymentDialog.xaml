<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.DeploymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Safe Streamer.bot Deployment"
    Width="920"
    Height="760"
    MinWidth="760"
    MinHeight="540"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
        FontSize="20"
        FontWeight="SemiBold"
        Text="Deployment health and recovery" />

    <Grid Grid.Row="1" Margin="0,14,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          Text="Streamer.bot installation" />
      <ComboBox
          x:Name="InstallationComboBox"
          Grid.Column="1"
          MinHeight="30"
          DisplayMemberPath="DisplayName"
          SelectionChanged="InstallationComboBox_SelectionChanged" />
      <Button
          Grid.Column="2"
          Margin="8,0,0,0"
          Content="Browse..."
          Click="Browse_Click" />
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,0,0,8" Orientation="Horizontal">
      <Button Content="Check Health" Click="CheckHealth_Click" />
      <Button
          x:Name="RepairButton"
          Content="Preview Install / Update"
          Click="PreviewInstall_Click" />
      <Button Content="Preview Rollback" Click="PreviewRollback_Click" />
      <Button Content="Preview Uninstall" Click="PreviewUninstall_Click" />
      <Button
          x:Name="EnablePackagingButton"
          Content="Enable Package Output"
          Visibility="Collapsed"
          Click="EnablePackaging_Click" />
    </StackPanel>

    <Grid Grid.Row="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
          x:Name="PlanSummaryText"
          Margin="0,0,0,6"
          FontWeight="SemiBold"
          Text="Select an installation and preview an operation." />
      <DataGrid
          x:Name="OperationsGrid"
          Grid.Row="1"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="110" Header="Change" Binding="{Binding Change}" />
          <DataGridTextColumn Width="2*" Header="Destination" Binding="{Binding DestinationRelativePath}" />
          <DataGridTextColumn Width="100" Header="Bytes" Binding="{Binding Size}" />
          <DataGridTextColumn Width="3*" Header="SHA-256" Binding="{Binding Sha256}" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBox
          x:Name="DetailsTextBox"
          Grid.Row="2"
          MinHeight="85"
          Margin="0,8,0,0"
          Padding="8"
          IsReadOnly="True"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto" />
      <GroupBox
          x:Name="ChecklistGroup"
          Grid.Row="3"
          Margin="0,8,0,0"
          Header="Streamer.bot completion checklist"
          IsEnabled="False">
        <DockPanel Margin="8">
          <Button
              x:Name="SaveChecklistButton"
              MinWidth="110"
              DockPanel.Dock="Right"
              Content="Save Checklist"
              Click="SaveChecklist_Click" />
          <WrapPanel VerticalAlignment="Center">
            <CheckBox x:Name="PackageImportedCheckBox" Margin="0,0,16,0" Content="Package imported" />
            <CheckBox x:Name="CompilerReferenceCheckBox" Margin="0,0,16,0" Content="DLL reference added" />
            <CheckBox x:Name="CodeCompiledCheckBox" Margin="0,0,16,0" Content="Code compiled" />
            <CheckBox x:Name="RuntimeVerifiedCheckBox" Content="Runtime verified" />
          </WrapPanel>
        </DockPanel>
      </GroupBox>
    </Grid>

    <CheckBox
        x:Name="ConfirmationCheckBox"
        Grid.Row="5"
        Margin="0,10,0,0"
        Content="I reviewed the destination, file changes, backups, and recovery operation."
        IsEnabled="False" />

    <DockPanel Grid.Row="6" Margin="0,12,0,0">
      <Button
          x:Name="CopyImportCodeButton"
          DockPanel.Dock="Left"
          Content="Copy Import Code"
          IsEnabled="False"
          Click="CopyImportCode_Click" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button MinWidth="90" Content="Close" IsCancel="True" />
        <Button
            x:Name="ApplyButton"
            MinWidth="110"
            Content="Apply Plan"
            IsEnabled="False"
            Click="Apply_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
