<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.SnippetBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Snippet Browser"
    Width="1100"
    Height="760"
    MinWidth="820"
    MinHeight="560"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="350" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Snippet browser" />
        <TextBlock
            x:Name="ProfileText"
            Margin="0,3,0,10"
            Foreground="{DynamicResource MutedTextBrush}" />
        <TextBox
            x:Name="SearchTextBox"
            Padding="8"
            AutomationProperties.Name="Search snippets"
            TextChanged="Filter_Changed"
            ToolTip="Filter by prefix, name, category, or description" />
      </StackPanel>

      <ComboBox
          x:Name="KindComboBox"
          Grid.Row="1"
          Margin="0,8,0,0"
          Padding="7"
          AutomationProperties.Name="Snippet kind"
          SelectionChanged="Filter_Changed">
        <ComboBoxItem Content="All snippets" Tag="all" />
        <ComboBoxItem Content="Method snippets" Tag="method" />
        <ComboBoxItem Content="Workflow snippets" Tag="workflow" />
      </ComboBox>

      <ListBox
          x:Name="SnippetsList"
          Grid.Row="2"
          Margin="0,8,0,0"
          SelectionChanged="SnippetsList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="5,4">
              <TextBlock
                  FontFamily="Cascadia Mono, Consolas"
                  Foreground="{DynamicResource AccentBrush}"
                  Text="{Binding Prefixes[0]}" />
              <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding Name}" />
              <TextBlock
                  Margin="0,2,0,0"
                  FontSize="11"
                  Foreground="{DynamicResource MutedTextBrush}"
                  Text="{Binding Kind}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <GridSplitter
        Grid.Column="1"
        HorizontalAlignment="Stretch"
        Background="{DynamicResource PanelBorderBrush}"
        ResizeDirection="Columns" />

    <ScrollViewer
        Grid.Column="2"
        Margin="8,0,0,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="6,0,8,8">
        <TextBlock
            x:Name="SnippetNameText"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Select a snippet" />
        <TextBlock
            x:Name="SnippetMetaText"
            Margin="0,4,0,0"
            Foreground="{DynamicResource AccentBrush}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="SnippetDescriptionText"
            Margin="0,10,0,0"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="SecurityText"
            Margin="0,8,0,0"
            Foreground="{DynamicResource MutedTextBrush}"
            TextWrapping="Wrap" />

        <Separator Margin="0,14" />
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Configure" />
        <TextBlock
            Margin="0,3,0,8"
            Foreground="{DynamicResource MutedTextBrush}"
            Text="Values remain selectable with Tab after insertion."
            TextWrapping="Wrap" />
        <StackPanel x:Name="GuidedFieldsPanel" />

        <TextBlock
            Margin="0,16,0,6"
            FontSize="16"
            FontWeight="SemiBold"
            Text="Code preview" />
        <TextBox
            x:Name="PreviewTextBox"
            MinHeight="150"
            Padding="10"
            AcceptsReturn="True"
            FontFamily="Cascadia Mono, Consolas"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />
        <TextBlock
            x:Name="ValidationText"
            Margin="0,8,0,0"
            Foreground="{DynamicResource ErrorTextBrush}"
            TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <TextBlock
          x:Name="RevisionText"
          VerticalAlignment="Center"
          Foreground="{DynamicResource MutedTextBrush}" />
      <StackPanel
          DockPanel.Dock="Right"
          HorizontalAlignment="Right"
          Orientation="Horizontal">
        <Button
            MinWidth="130"
            Content="Import catalogue..."
            Click="ImportCatalogue_Click" />
        <Button
            MinWidth="90"
            Content="Cancel"
            IsCancel="True" />
        <Button
            x:Name="InsertButton"
            MinWidth="120"
            Content="Insert"
            Click="InsertButton_Click"
            IsDefault="True"
            IsEnabled="False" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
