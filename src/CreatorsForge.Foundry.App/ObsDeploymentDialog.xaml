<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.ObsDeploymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Safe OBS Studio Deployment"
    Width="940"
    Height="720"
    MinWidth="780"
    MinHeight="540"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock FontSize="20" FontWeight="SemiBold" Text="OBS deployment health and recovery" />

    <Grid Grid.Row="1" Margin="0,14,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="OBS Studio installation" />
      <ComboBox
          x:Name="InstallationComboBox"
          Grid.Column="1"
          MinHeight="30"
          DisplayMemberPath="DisplayName"
          SelectionChanged="InstallationComboBox_SelectionChanged" />
      <Button Grid.Column="2" Margin="8,0,0,0" Content="Browse..." Click="Browse_Click" />
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,0,0,8" Orientation="Horizontal">
      <Button Content="Check Health" Click="CheckHealth_Click" />
      <Button x:Name="RepairButton" Content="Preview Install / Update" Click="PreviewInstall_Click" />
      <Button Content="Preview Rollback" Click="PreviewRollback_Click" />
      <Button Content="Preview Uninstall" Click="PreviewUninstall_Click" />
    </StackPanel>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
          x:Name="PlanSummaryText"
          Margin="0,0,0,6"
          FontWeight="SemiBold"
          Text="Select an installation and preview an operation." />
      <DataGrid
          x:Name="OperationsGrid"
          Grid.Row="1"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="110" Header="Change" Binding="{Binding Change}" />
          <DataGridTextColumn Width="2*" Header="Destination" Binding="{Binding DestinationRelativePath}" />
          <DataGridTextColumn Width="100" Header="Bytes" Binding="{Binding Size}" />
          <DataGridTextColumn Width="3*" Header="SHA-256" Binding="{Binding Sha256}" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBox
          x:Name="DetailsTextBox"
          Grid.Row="2"
          MinHeight="100"
          Margin="0,8,0,0"
          Padding="8"
          IsReadOnly="True"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto" />
      <TextBlock
          x:Name="LogStatusText"
          Grid.Row="3"
          Margin="0,8,0,0"
          TextWrapping="Wrap"
          Text="OBS log status will appear after a health check." />
    </Grid>

    <CheckBox
        x:Name="ConfirmationCheckBox"
        Grid.Row="4"
        Margin="0,10,0,0"
        Content="I reviewed the OBS destination, file changes, backups, and recovery operation."
        IsEnabled="False" />

    <DockPanel Grid.Row="5" Margin="0,12,0,0">
      <TextBlock
          DockPanel.Dock="Left"
          VerticalAlignment="Center"
          Text="OBS must be closed before preview or apply." />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button MinWidth="90" Content="Close" IsCancel="True" />
        <Button
            x:Name="ApplyButton"
            MinWidth="110"
            Content="Apply Plan"
            IsEnabled="False"
            Click="Apply_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
