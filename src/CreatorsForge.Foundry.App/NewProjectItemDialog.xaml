<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.NewProjectItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add project item"
    Width="620"
    Height="330"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    AutomationProperties.Name="Add project item">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Add project item" />
    <TextBlock
        Grid.Row="1"
        Margin="0,6,0,14"
        Foreground="{DynamicResource MutedTextBrush}"
        Text="{Binding TargetDescription, RelativeSource={RelativeSource AncestorType=Window}}"
        TextWrapping="Wrap" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="125" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Item type" />
      <ComboBox
          x:Name="ItemTypeComboBox"
          Grid.Column="1"
          Margin="6"
          ItemsSource="{Binding ItemTypes, RelativeSource={RelativeSource AncestorType=Window}}"
          SelectionChanged="ItemTypeComboBox_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Name" />
      <TextBox
          x:Name="NameTextBox"
          Grid.Row="1"
          Grid.Column="1"
          Margin="6"
          Padding="7"
          AutomationProperties.Name="New project item name" />
    </Grid>

    <TextBlock
        Grid.Row="3"
        Margin="0,16,0,16"
        VerticalAlignment="Top"
        Foreground="{DynamicResource MutedTextBrush}"
        Text="Extensions are added automatically when omitted. Existing files are never overwritten."
        TextWrapping="Wrap" />

    <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="90" Content="Cancel" IsCancel="True" />
      <Button MinWidth="90" Content="Add" IsDefault="True" Click="Add_Click" />
    </StackPanel>
  </Grid>
</Window>
