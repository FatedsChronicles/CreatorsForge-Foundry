<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.ObsPluginDesignerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OBS Plugin Designer"
    Width="1180"
    Height="780"
    MinWidth="940"
    MinHeight="620"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="OBS plugin designer" />
      <TextBlock
          x:Name="ContractText"
          Margin="0,3,0,12"
          Foreground="{DynamicResource MutedTextBrush}" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="390" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <GroupBox Header="Module metadata" Padding="10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock VerticalAlignment="Center" Text="Module name" />
              <TextBox x:Name="ModuleNameTextBox" Grid.Column="1" Margin="6,3" TextChanged="DesignField_Changed" />
              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Display name" />
              <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Grid.Column="1" Margin="6,3" TextChanged="DesignField_Changed" />
              <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Author" />
              <TextBox x:Name="AuthorTextBox" Grid.Row="2" Grid.Column="1" Margin="6,3" TextChanged="DesignField_Changed" />
              <TextBlock Grid.Row="3" VerticalAlignment="Top" Margin="0,8,0,0" Text="Description" />
              <TextBox
                  x:Name="DescriptionTextBox"
                  Grid.Row="3"
                  Grid.Column="1"
                  Height="72"
                  Margin="6,3"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  TextChanged="DesignField_Changed" />
            </Grid>
          </GroupBox>

          <GroupBox Margin="0,10,0,0" Header="Generated component" Padding="10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock VerticalAlignment="Center" Text="Template" />
              <ComboBox
                  x:Name="TemplateComboBox"
                  Grid.Column="1"
                  Margin="6,3"
                  DisplayMemberPath="Name"
                  SelectionChanged="Template_Changed" />
              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Source file" />
              <ComboBox
                  x:Name="SourceComboBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="6,3"
                  SelectionChanged="DesignField_Changed" />
              <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Component ID" />
              <TextBox x:Name="ComponentIdTextBox" Grid.Row="2" Grid.Column="1" Margin="6,3" TextChanged="DesignField_Changed" />
              <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="OBS name" />
              <TextBox x:Name="ComponentNameTextBox" Grid.Row="3" Grid.Column="1" Margin="6,3" TextChanged="DesignField_Changed" />
            </Grid>
          </GroupBox>

          <Border Margin="0,10,0,0" Padding="10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock x:Name="TemplateDescriptionText" TextWrapping="Wrap" />
              <TextBlock x:Name="TemplateResultText" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <CheckBox
              x:Name="ConfirmOverwriteCheckBox"
              Margin="2,14,0,0">
            <TextBlock Text="Replace the selected source file with the generated preview" TextWrapping="Wrap" />
          </CheckBox>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          Background="{DynamicResource PanelBorderBrush}"
          ResizeDirection="Columns" />

      <TabControl Grid.Column="2" Margin="8,0,0,0">
        <TabItem Header="Generated preview">
          <TextBox
              x:Name="GeneratedPreviewTextBox"
              Padding="10"
              FontFamily="Cascadia Mono, Consolas"
              FontSize="13"
              IsReadOnly="True"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto" />
        </TabItem>
        <TabItem Header="Current source">
          <TextBox
              x:Name="CurrentSourceTextBox"
              Padding="10"
              FontFamily="Cascadia Mono, Consolas"
              FontSize="13"
              IsReadOnly="True"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto" />
        </TabItem>
      </TabControl>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button MinWidth="90" Content="Cancel" IsCancel="True" />
        <Button MinWidth="120" Content="Save Design" IsDefault="True" Click="Save_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
