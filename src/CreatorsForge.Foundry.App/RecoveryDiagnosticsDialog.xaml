<Window Style="{StaticResource FoundryWindowStyle}" x:Class="CreatorsForge.Foundry.App.RecoveryDiagnosticsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recovery and Diagnostics" Width="720" Height="500" MinWidth="600" MinHeight="400" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Recovery and diagnostics"/>
    <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,6,0,12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
    <ListBox x:Name="ItemsList" Grid.Row="2" AutomationProperties.Name="Local recovery and failure files"/>
    <StackPanel Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="160" Content="Create Diagnostic Bundle..." Click="CreateBundle_Click"/>
      <Button MinWidth="90" Content="Close" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
