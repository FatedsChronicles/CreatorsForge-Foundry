<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.StreamerBotDesignerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CreatorsForge.Foundry.App"
    Title="Streamer.bot Designer"
    Width="1050"
    Height="720"
    MinWidth="850"
    MinHeight="560"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Author" />
      <TextBox
          x:Name="AuthorTextBox"
          Grid.Column="1"
          Margin="8,0,18,8" />
      <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Description" />
      <TextBox
          x:Name="DescriptionTextBox"
          Grid.Column="3"
          Margin="8,0,0,8" />
    </Grid>

    <TabControl Grid.Row="1">
      <TabItem Header="Actions">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DataGrid
              x:Name="ActionsGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              BeginningEdit="Grid_BeginningEdit"
              SelectionChanged="ActionsGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
              <DataGridTextColumn Width="2*" Header="Name" Binding="{Binding Name}" />
              <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" />
              <DataGridTextColumn Width="*" Header="Queue ID" Binding="{Binding QueueId}" />
              <DataGridCheckBoxColumn Header="Concurrent" Binding="{Binding Concurrent}" />
              <DataGridCheckBoxColumn Header="Always run" Binding="{Binding AlwaysRun}" />
              <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="1" Margin="0,6" Orientation="Horizontal">
            <Button Content="Add action" Click="AddAction_Click" />
            <Button Content="Remove action" Click="RemoveAction_Click" />
          </StackPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Triggers">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                  <Button Content="Add" Click="AddTrigger_Click" />
                  <Button Content="Remove" Click="RemoveTrigger_Click" />
                </StackPanel>
                <DataGrid
                    x:Name="TriggersGrid"
                    AutoGenerateColumns="False"
                    BeginningEdit="Grid_BeginningEdit"
                    CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
                    <DataGridComboBoxColumn
                        Width="*"
                        Header="Kind"
                        SelectedItemBinding="{Binding Kind}"
                        ItemsSource="{x:Static local:StreamerBotDesignerDialog.TriggerKinds}" />
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" />
                    <DataGridTextColumn Width="*" Header="Command ID" Binding="{Binding CommandId}" />
                    <DataGridTextColumn Header="Source type" IsReadOnly="True" Binding="{Binding SourceType}" />
                    <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Sub-actions">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                  <Button Content="Add" Click="AddSubAction_Click" />
                  <Button Content="Remove" Click="RemoveSubAction_Click" />
                  <Button Content="Open C# source" Click="OpenCSharpSource_Click" />
                </StackPanel>
                <DataGrid
                    x:Name="SubActionsGrid"
                    AutoGenerateColumns="False"
                    BeginningEdit="Grid_BeginningEdit"
                    CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
                    <DataGridComboBoxColumn
                        Width="*"
                        Header="Kind"
                        SelectedItemBinding="{Binding Kind}"
                        ItemsSource="{x:Static local:StreamerBotDesignerDialog.SubActionKinds}" />
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" />
                    <DataGridTextColumn Width="*" Header="Variable" Binding="{Binding VariableName}" />
                    <DataGridTextColumn Width="*" Header="Value" Binding="{Binding Value}" />
                    <DataGridCheckBoxColumn Header="Auto type" Binding="{Binding AutoType}" />
                    <DataGridTextColumn Width="2*" Header="C# source" IsReadOnly="True" Binding="{Binding SourcePath}" />
                    <DataGridTextColumn Header="Source type" IsReadOnly="True" Binding="{Binding SourceType}" />
                    <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </GroupBox>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Commands">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Orientation="Horizontal">
            <Button Content="Add command" Click="AddCommand_Click" />
            <Button Content="Remove command" Click="RemoveCommand_Click" />
          </StackPanel>
          <DataGrid
              x:Name="CommandsGrid"
              AutoGenerateColumns="False"
              BeginningEdit="Grid_BeginningEdit"
              CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
              <DataGridTextColumn Width="*" Header="Name" Binding="{Binding Name}" />
              <DataGridTextColumn Width="2*" Header="Commands (comma separated)" Binding="{Binding Aliases}" />
              <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" />
              <DataGridCheckBoxColumn Header="Case sensitive" Binding="{Binding CaseSensitive}" />
              <DataGridTextColumn Header="Global cooldown" Binding="{Binding GlobalCooldown}" />
              <DataGridTextColumn Header="User cooldown" Binding="{Binding UserCooldown}" />
              <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Queues">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Orientation="Horizontal">
            <Button Content="Add queue" Click="AddQueue_Click" />
            <Button Content="Remove queue" Click="RemoveQueue_Click" />
          </StackPanel>
          <DataGrid
              x:Name="QueuesGrid"
              AutoGenerateColumns="False"
              BeginningEdit="Grid_BeginningEdit"
              CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
              <DataGridTextColumn Width="2*" Header="Name" Binding="{Binding Name}" />
              <DataGridCheckBoxColumn Header="Blocking" Binding="{Binding Blocking}" />
              <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock
          x:Name="StatusText"
          VerticalAlignment="Center"
          Foreground="{DynamicResource MutedTextBrush}" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button MinWidth="90" Content="Cancel" IsCancel="True" />
        <Button MinWidth="90" Content="Save" IsDefault="True" Click="Save_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
