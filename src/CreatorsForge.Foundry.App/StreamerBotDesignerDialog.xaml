<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.StreamerBotDesignerDialog"
    x:Name="DesignerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CreatorsForge.Foundry.App"
    Title="Streamer.bot Designer"
    Width="1400"
    Height="720"
    MinWidth="1200"
    MinHeight="560"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Author" />
      <TextBox
          x:Name="AuthorTextBox"
          Grid.Column="1"
          Margin="8,0,18,8" />
      <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Description" />
      <TextBox
          x:Name="DescriptionTextBox"
          Grid.Column="3"
          Margin="8,0,0,8" />
    </Grid>

    <TabControl Grid.Row="1">
      <TabItem Header="Actions">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DataGrid
              x:Name="ActionsGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              BeginningEdit="Grid_BeginningEdit"
              CurrentCellChanged="ActionsGrid_CurrentCellChanged"
              SelectionChanged="ActionsGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
              <DataGridTextColumn Width="2*" Header="Name" Binding="{Binding Name}" />
              <DataGridTemplateColumn Width="*" Header="Group">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Group}" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <ComboBox IsEditable="True"
                        ItemsSource="{Binding GroupOptions, RelativeSource={RelativeSource AncestorType={x:Type local:StreamerBotDesignerDialog}}}"
                        Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Width="2*" Header="Description" Binding="{Binding Description}" />
              <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" />
              <DataGridTemplateColumn Width="*" Header="Queue ID">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding QueueId}" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <ComboBox IsEditable="False"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding QueueOptions, RelativeSource={RelativeSource AncestorType={x:Type local:StreamerBotDesignerDialog}}}"
                        SelectedValue="{Binding QueueId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Id" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Width="*" Header="Queue Name" IsReadOnly="True" Binding="{Binding QueueName}" />
              <DataGridCheckBoxColumn Header="Concurrent" Binding="{Binding Concurrent}" />
              <DataGridCheckBoxColumn Header="Always run" Binding="{Binding AlwaysRun}" />
              <DataGridCheckBoxColumn Header="Random" Binding="{Binding RandomAction}" />
              <DataGridCheckBoxColumn Header="Exclude pending" Binding="{Binding ExcludeFromPending}" />
              <DataGridCheckBoxColumn Header="Exclude history" Binding="{Binding ExcludeFromHistory}" />
              <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="1" Margin="0,6" Orientation="Horizontal">
            <Button Content="Add action" Click="AddAction_Click" />
            <Button Content="Remove action" Click="RemoveAction_Click" />
            <Button Content="Duplicate" Click="DuplicateAction_Click" />
            <Button Content="Move up" Click="MoveActionUp_Click" />
            <Button Content="Move down" Click="MoveActionDown_Click" />
          </StackPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Triggers">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                  <Button Content="Add from catalogue..." Click="AddTrigger_Click" />
                  <Button Content="Remove" Click="RemoveTrigger_Click" />
                </StackPanel>
                <DataGrid
                    x:Name="TriggersGrid"
                    AutoGenerateColumns="False"
                    BeginningEdit="Grid_BeginningEdit"
                    CurrentCellChanged="Grid_CurrentCellChanged"
                    CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
                    <DataGridTemplateColumn Width="*" Header="Kind">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Foreground="{DynamicResource TextBrush}" Text="{Binding Kind}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox
                              Background="{DynamicResource EditorBackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              ItemsSource="{x:Static local:StreamerBotDesignerDialog.TriggerKinds}"
                              SelectedItem="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" />
                    <DataGridTextColumn Width="*" Header="Command ID" Binding="{Binding CommandId}" />
                    <DataGridTextColumn Header="Source type" IsReadOnly="True" Binding="{Binding SourceType}" />
                    <DataGridTextColumn Width="2*" Header="Runtime arguments" IsReadOnly="True" Binding="{Binding RuntimeArguments}" />
                    <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Sub-actions">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                  <Button Content="Add from catalogue..." Click="AddSubAction_Click" />
                  <Button x:Name="AddExecuteCSharpButton" Content="Add Execute C#..." Click="AddExecuteCSharp_Click" />
                  <Button x:Name="ConvertToCSharpButton" Content="Convert to C#..." Click="ConvertSubActionToCSharp_Click" />
                  <Button Content="Remove" Click="RemoveSubAction_Click" />
                  <Button Content="Duplicate" Click="DuplicateSubAction_Click" />
                  <Button Content="Move up" Click="MoveSubActionUp_Click" />
                  <Button Content="Move down" Click="MoveSubActionDown_Click" />
                  <Button Content="Open C# source" Click="OpenCSharpSource_Click" />
                  <Button Content="Remove absolute references" Click="RemoveAbsoluteReferences_Click" />
                </StackPanel>
                <DataGrid
                    x:Name="SubActionsGrid"
                    AutoGenerateColumns="False"
                    BeginningEdit="Grid_BeginningEdit"
                    CurrentCellChanged="Grid_CurrentCellChanged"
                    CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
                    <DataGridTemplateColumn Width="*" Header="Kind">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Foreground="{DynamicResource TextBrush}" Text="{Binding Kind}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox
                              Background="{DynamicResource EditorBackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              ItemsSource="{x:Static local:StreamerBotDesignerDialog.SubActionKinds}"
                              SelectedItem="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" />
                    <DataGridTextColumn Width="*" Header="Variable" Binding="{Binding VariableName}" />
                    <DataGridTextColumn Width="*" Header="Value" Binding="{Binding Value}" />
                    <DataGridCheckBoxColumn Header="Auto type" Binding="{Binding AutoType}" />
                    <DataGridTextColumn x:Name="WeightColumn" Header="Weight" Binding="{Binding Weight}" />
                    <DataGridTextColumn Width="2*" Header="C# source" IsReadOnly="True" Binding="{Binding SourcePath}" />
                    <DataGridTextColumn Width="*" Header="C# state" IsReadOnly="True" Binding="{Binding CSharpState}" />
                    <DataGridTextColumn Width="2*" Header="References (; separated)" Binding="{Binding ReferenceList}" />
                    <DataGridTextColumn Header="Source type" IsReadOnly="True" Binding="{Binding SourceType}" />
                    <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </GroupBox>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Commands">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Orientation="Horizontal">
            <Button Content="Add command" Click="AddCommand_Click" />
            <Button Content="Remove command" Click="RemoveCommand_Click" />
          </StackPanel>
          <DataGrid
              x:Name="CommandsGrid"
              AutoGenerateColumns="False"
              BeginningEdit="Grid_BeginningEdit"
              CurrentCellChanged="Grid_CurrentCellChanged"
              CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
              <DataGridTextColumn Width="*" Header="Name" Binding="{Binding Name}" />
              <DataGridTextColumn Width="2*" Header="Commands (comma separated)" Binding="{Binding Aliases}" />
              <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" />
              <DataGridCheckBoxColumn Header="Case sensitive" Binding="{Binding CaseSensitive}" />
              <DataGridCheckBoxColumn Header="Ignore bot" Binding="{Binding IgnoreBotAccount}" />
              <DataGridCheckBoxColumn Header="Ignore internal" Binding="{Binding IgnoreInternalMessages}" />
              <DataGridTextColumn Header="Sources" Binding="{Binding Sources}" />
              <DataGridTextColumn Width="2*" Header="Description" Binding="{Binding Description}" />
              <DataGridTextColumn Header="Global cooldown" Binding="{Binding GlobalCooldown}" />
              <DataGridTextColumn Header="User cooldown" Binding="{Binding UserCooldown}" />
              <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Queues">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Orientation="Horizontal">
            <Button Content="Add queue" Click="AddQueue_Click" />
            <Button Content="Remove queue" Click="RemoveQueue_Click" />
          </StackPanel>
          <DataGrid
              x:Name="QueuesGrid"
              AutoGenerateColumns="False"
              BeginningEdit="Grid_BeginningEdit"
              CurrentCellChanged="Grid_CurrentCellChanged"
              CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}" />
              <DataGridTextColumn Width="2*" Header="Name" Binding="{Binding Name}" />
              <DataGridCheckBoxColumn Header="Blocking" Binding="{Binding Blocking}" />
              <DataGridTextColumn Width="2*" Header="Description" Binding="{Binding Description}" />
              <DataGridTextColumn Header="Mode" IsReadOnly="True" Binding="{Binding Mode}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Resources">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock FontWeight="SemiBold" Text="Resource requirements and portability" />
            <TextBlock
                Margin="0,3,0,0"
                Foreground="{DynamicResource MutedTextBrush}"
                TextWrapping="Wrap"
                Text="Describe installation-specific values without storing passwords, tokens, API keys, or other credentials. Bindings use entity-type:entity-id:property and multiple bindings are separated with semicolons." />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Orientation="Horizontal">
            <Button Content="Add resource" Click="AddResource_Click" />
            <Button Content="Remove resource" Click="RemoveResource_Click" />
          </StackPanel>
          <DataGrid
              x:Name="ResourcesGrid"
              AutoGenerateColumns="False"
              BeginningEdit="Grid_BeginningEdit"
              CurrentCellChanged="Grid_CurrentCellChanged"
              CanUserAddRows="False">
            <DataGrid.Resources>
              <ContextMenu
                  x:Key="ResourceEditContextMenu"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}">
                <MenuItem
                    Header="Cut"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    Command="ApplicationCommands.Cut" />
                <MenuItem
                    Header="Copy"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    Command="ApplicationCommands.Copy" />
                <MenuItem
                    Header="Paste"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    Command="ApplicationCommands.Paste" />
              </ContextMenu>
              <Style
                  x:Key="ResourceTextEditorStyle"
                  TargetType="TextBox"
                  BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="ContextMenu" Value="{StaticResource ResourceEditContextMenu}" />
              </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Header="ID" Binding="{Binding Id}"
                  EditingElementStyle="{StaticResource ResourceTextEditorStyle}" />
              <DataGridTextColumn Width="2*" Header="Name" Binding="{Binding Name}"
                  EditingElementStyle="{StaticResource ResourceTextEditorStyle}" />
              <DataGridTemplateColumn Width="*" Header="Type">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource TextBrush}" Text="{Binding Type}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <ComboBox
                        Background="{DynamicResource EditorBackgroundBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        ItemsSource="{x:Static local:StreamerBotDesignerDialog.ResourceTypes}"
                        SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}" />
              <DataGridTemplateColumn Width="2*" Header="Portability">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource TextBrush}" Text="{Binding Portability}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <ComboBox
                        Background="{DynamicResource EditorBackgroundBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        ItemsSource="{x:Static local:StreamerBotDesignerDialog.PortabilityOptions}"
                        SelectedItem="{Binding Portability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Width="2*" Header="Suggested/default value" Binding="{Binding SuggestedValue}"
                  EditingElementStyle="{StaticResource ResourceTextEditorStyle}" />
              <DataGridTextColumn Width="2*" Header="Validation pattern" Binding="{Binding ValidationPattern}"
                  EditingElementStyle="{StaticResource ResourceTextEditorStyle}" />
              <DataGridTextColumn Width="3*" Header="Bindings" Binding="{Binding Bindings}"
                  EditingElementStyle="{StaticResource ResourceTextEditorStyle}" />
              <DataGridTextColumn Width="2*" Header="Description" Binding="{Binding Description}"
                  EditingElementStyle="{StaticResource ResourceTextEditorStyle}" />
              <DataGridTextColumn Header="Usage" IsReadOnly="True" Binding="{Binding Usage}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Validation">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Margin="0,0,0,8" Text="Errors block saving and building. Warnings are advisory and do not block either operation." />
          <DataGrid x:Name="ValidationGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" />
              <DataGridTextColumn Header="Code" Binding="{Binding Code}" />
              <DataGridTextColumn Width="3*" Header="Message" Binding="{Binding Message}" />
              <DataGridTextColumn Width="2*" Header="Location" Binding="{Binding Path}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock
          x:Name="StatusText"
          VerticalAlignment="Center"
          Foreground="{DynamicResource MutedTextBrush}" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button MinWidth="90" Content="Cancel" IsCancel="True" />
        <Button MinWidth="90" Content="Save" IsDefault="True" Click="Save_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
