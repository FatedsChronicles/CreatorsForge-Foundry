<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.ObsSdkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Development Toolchain"
    Width="760"
    Height="650"
    MinWidth="640"
    MinHeight="520"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="OBS development toolchain" />
    <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}"
        Text="Foundry discovers Visual Studio with vswhere, validates the x64 C++ tools, and passes the selected instance only to Foundry build processes. Windows PATH is never changed."
        TextWrapping="Wrap" />

    <GroupBox Grid.Row="2" Margin="0,16,0,0" Header="Visual Studio C++ x64 tools">
      <Grid Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="VisualStudioComboBox" Padding="7"
            SelectionChanged="VisualStudio_SelectionChanged"
            AutomationProperties.Name="Visual Studio installation">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding SelectionLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" MinWidth="110" Margin="8,0,0,0" Content="Auto-detect" Click="AutoDetect_Click" />
        <Button Grid.Column="2" MinWidth="150" Margin="8,0,0,0" Content="Select folder…" Click="SelectVisualStudio_Click" />
        <TextBlock x:Name="VisualStudioStatusText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
            FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}"
            Text="Choose the Visual Studio installation root, such as C:\Program Files\Microsoft Visual Studio\2022\Community. Foundry locates cl.exe, link.exe, lib.exe, dumpbin.exe, and VsDevCmd.bat beneath it."
            TextWrapping="Wrap" />
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="3" Margin="0,12,0,0" Header="Pinned OBS SDK">
      <StackPanel Margin="10">
        <TextBlock x:Name="StatusText" FontWeight="SemiBold" />
        <TextBlock x:Name="SdkPathText" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </GroupBox>

    <TextBox x:Name="ProgressTextBox" Grid.Row="4" Margin="0,12,0,0" Padding="8"
        IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    <WrapPanel Grid.Row="5" Margin="0,16,0,0" HorizontalAlignment="Right">
      <Button MinWidth="110" Content="Copy SDK Path" Click="CopyPath_Click" />
      <Button MinWidth="150" Content="Use Offline Archives…" Click="OfflineArchives_Click" />
      <Button x:Name="InstallButton" MinWidth="135" Content="Install SDK" Click="Install_Click" />
      <Button MinWidth="120" Content="Cancel" IsCancel="True" />
      <Button MinWidth="135" Content="Save &amp; Close" IsDefault="True" Click="Save_Click" />
    </WrapPanel>
  </Grid>
</Window>
