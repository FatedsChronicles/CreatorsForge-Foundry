<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.ObsSdkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Development Toolchain"
    Width="680"
    Height="480"
    MinWidth="560"
    MinHeight="320"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="OBS development toolchain" />
    <TextBlock
        Grid.Row="1"
        Margin="0,12,0,0"
        Foreground="{DynamicResource MutedTextBrush}"
        Text="Foundry checks CMake, Visual Studio C++ tools, and the pinned OBS 32.1.2 SDK used for verified OBS 32.1.2 and 32.2.1 runtimes. Official archives are checksum-verified; an offline archive folder can be selected."
        TextWrapping="Wrap" />
    <Border
        Grid.Row="2"
        Margin="0,16,0,0"
        Padding="12"
        Background="{DynamicResource ButtonBackgroundBrush}"
        BorderBrush="{DynamicResource PanelBorderBrush}"
        BorderThickness="1"
        CornerRadius="4">
      <StackPanel>
        <TextBlock x:Name="StatusText" FontWeight="SemiBold" />
        <TextBlock x:Name="SdkPathText" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBox
        x:Name="ProgressTextBox"
        Grid.Row="3"
        Margin="0,12,0,0"
        Padding="8"
        IsReadOnly="True"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto" />
    <StackPanel
        Grid.Row="4"
        Margin="0,16,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
      <Button MinWidth="110" Content="Copy SDK Path" Click="CopyPath_Click" />
      <Button MinWidth="150" Content="Use Offline Archives..." Click="OfflineArchives_Click" />
      <Button x:Name="InstallButton" MinWidth="150" Content="Install SDK" Click="Install_Click" />
      <Button MinWidth="90" Content="Close" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
