<Window Style="{StaticResource FoundryWindowStyle}"
    x:Class="CreatorsForge.Foundry.App.ObsSdkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Development Toolchain" Width="860" Height="850" MinWidth="720" MinHeight="680"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="OBS development toolchain" />
    <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
        Text="Foundry validates CMake, Visual Studio C++ x64, the Windows SDK, target architecture, and the pinned OBS SDK. Selections affect only Foundry build processes; Windows PATH is never changed." />

    <GroupBox Grid.Row="2" Margin="0,14,0,0" Header="Visual Studio C++ x64 tools">
      <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="VisualStudioComboBox" Padding="7" SelectionChanged="VisualStudio_SelectionChanged" AutomationProperties.Name="Visual Studio installation">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding SelectionLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" MinWidth="105" Margin="8,0,0,0" Content="Auto-detect" Click="AutoDetect_Click"/>
        <Button Grid.Column="2" MinWidth="140" Margin="8,0,0,0" Content="Select folder…" Click="SelectVisualStudio_Click"/>
        <TextBlock x:Name="VisualStudioStatusText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="3" Margin="0,10,0,0" Header="CMake">
      <Grid Margin="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="CMakeStatusText" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <Button Grid.Column="1" MinWidth="105" Margin="8,0,0,0" Content="Auto-detect" Click="AutoDetectCMake_Click"/>
        <Button Grid.Column="2" MinWidth="140" Margin="8,0,0,0" Content="Select cmake.exe…" Click="SelectCMake_Click"/>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="4" Margin="0,10,0,0" Header="Pinned OBS SDK">
      <StackPanel Margin="10"><TextBlock x:Name="StatusText" FontWeight="SemiBold"/><TextBlock x:Name="SdkPathText" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
    </GroupBox>

    <ListBox x:Name="ReadinessList" Grid.Row="5" Margin="0,12,0,0" AutomationProperties.Name="Native toolchain readiness">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold" Text="{Binding Status}"/>
            <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Check.Name}"/>
            <StackPanel Grid.Column="2"><TextBlock Text="{Binding Check.Details}" TextWrapping="Wrap"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Check.RecommendedAction}" TextWrapping="Wrap"/></StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="6" Margin="0,10,0,0" Padding="10" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Disposable native build verification"/>
          <TextBlock x:Name="VerificationStatusText" Margin="0,4,12,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
              Text="Not run. This compiles a temporary OBS module without changing the open project."/>
        </StackPanel>
        <Button x:Name="VerifyNativeBuildButton" Grid.Column="1" MinWidth="165" Content="Verify native build" Click="VerifyNativeBuild_Click"/>
      </Grid>
    </Border>

    <WrapPanel Grid.Row="7" Margin="0,10,0,0" HorizontalAlignment="Right">
      <Button MinWidth="130" Content="Refresh checks" Click="RefreshChecks_Click"/>
      <Button MinWidth="165" Content="Use recommended tools" Click="UseRecommendedTools_Click"/>
      <Button MinWidth="170" Content="Open Visual Studio Installer" Click="OpenVisualStudioInstaller_Click"/>
      <Button MinWidth="145" Content="Get CMake…" Click="OpenCMakeDownload_Click"/>
    </WrapPanel>
    <WrapPanel Grid.Row="8" Margin="0,12,0,0" HorizontalAlignment="Right">
      <Button MinWidth="110" Content="Copy SDK Path" Click="CopyPath_Click"/>
      <Button MinWidth="150" Content="Use Offline Archives…" Click="OfflineArchives_Click"/>
      <Button x:Name="InstallButton" MinWidth="135" Content="Install SDK" Click="Install_Click"/>
      <Button MinWidth="100" Content="Cancel" IsCancel="True"/>
      <Button MinWidth="135" Content="Save &amp; Close" IsDefault="True" Click="Save_Click"/>
    </WrapPanel>
  </Grid>
</Window>
