{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatorsforge.dev/schemas/workspaces/foundry-workspace-v1.schema.json",
  "title": "Creators Forge Foundry multi-project workspace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "projects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.foundryproj$"
      }
    },
    "startupProject": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.foundryproj$"
    }
  }
}
