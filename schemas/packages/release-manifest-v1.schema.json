{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorsforge.dev/foundry/release-manifest/v1",
  "title": "Creators Forge Foundry release build manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "foundryVersion",
    "buildTimestampUtc",
    "configuration",
    "project",
    "target",
    "dependencies",
    "warnings",
    "validation",
    "signing",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "foundryVersion": { "type": "string", "minLength": 1 },
    "buildTimestampUtc": { "type": "string", "format": "date-time" },
    "configuration": { "const": "Release" },
    "project": { "$ref": "https://schemas.creatorsforge.dev/foundry/package-ir/v1#/$defs/project" },
    "target": { "$ref": "https://schemas.creatorsforge.dev/foundry/package-ir/v1#/$defs/target" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["runtime", "library", "tool"] },
          "license": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["projectValidated", "buildSucceeded", "artifactsVerified", "archiveVerified", "signingVerified"],
      "properties": {
        "projectValidated": { "const": true },
        "buildSucceeded": { "const": true },
        "artifactsVerified": { "const": true },
        "archiveVerified": { "const": true },
        "signingVerified": { "const": true }
      },
      "additionalProperties": false
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "applied", "signedFiles"],
      "properties": {
        "requested": { "type": "boolean" },
        "applied": { "type": "boolean" },
        "tool": { "type": "string", "minLength": 1 },
        "certificateThumbprint": { "type": "string", "minLength": 1 },
        "signedFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "size", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
