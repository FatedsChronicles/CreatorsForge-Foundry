{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorsforge.dev/foundry/package-ir/v1",
  "title": "Creators Forge Foundry package intermediate representation",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "target",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "provider",
        "profile",
        "framework"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "cphCatalogueRevision": {
          "type": "string",
          "pattern": "^1\\.0\\.0\\+[0-9a-f]{12}$"
        },
        "obsApiVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "obsSdkVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "obsTemplateRevision": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"
        },
        "obsComponentId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "managedAssembly",
              "cphInlineBridge",
              "streamerBotPackage",
              "streamerBotPackageReport",
              "streamerBotImportReport",
              "nativeObsPlugin",
              "obsPluginPackage"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["provider", "profile", "framework"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "framework": { "type": "string", "minLength": 1 },
        "cphCatalogueRevision": { "type": "string", "pattern": "^1\\.0\\.0\\+[0-9a-f]{12}$" },
        "obsApiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "obsSdkVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "obsTemplateRevision": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$" },
        "obsComponentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
