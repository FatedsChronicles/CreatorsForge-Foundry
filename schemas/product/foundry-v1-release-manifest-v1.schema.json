{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorsforge.dev/foundry/product/v1-release-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "version", "createdAtUtc", "sourceRevision", "sourceInventorySha256", "authenticodeStatus", "releaseBlockers", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["release-candidate", "stable"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "sourceInventorySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authenticodeStatus": { "type": "string", "minLength": 1 },
    "releaseBlockers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}

