{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatorsforge.dev/schemas/snippets/snippet-catalogue-v1.schema.json",
  "title": "Creators Forge Foundry snippet catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "snippets"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "snippets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snippet"
      }
    }
  },
  "$defs": {
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "author",
        "target",
        "language",
        "kind",
        "description",
        "source",
        "prefixes",
        "profiles",
        "categories",
        "requiredMethods",
        "body",
        "security"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "const": "streamerbot"
        },
        "language": {
          "const": "csharp"
        },
        "kind": {
          "enum": ["method", "workflow"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": ["built-in", "project", "user", "community"]
        },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredMethods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "guide": {
          "$ref": "#/$defs/guide"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileAccess", "networkAccess", "processExecution"],
      "properties": {
        "fileAccess": {
          "type": "boolean"
        },
        "networkAccess": {
          "type": "boolean"
        },
        "processExecution": {
          "type": "boolean"
        }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/guideField"
          }
        }
      }
    },
    "guideField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "label", "description", "valueKind", "options"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "valueKind": {
          "enum": ["string", "code", "identifier", "type", "boolean", "integer"]
        },
        "options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
