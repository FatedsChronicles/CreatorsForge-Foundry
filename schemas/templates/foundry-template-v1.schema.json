{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatorsforge.dev/schemas/templates/foundry-template-v1.schema.json",
  "title": "Creators Forge Foundry project template v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "provider", "description", "project", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*-v[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "provider": { "enum": ["streamerbot", "obsstudio"] },
    "description": { "type": "string", "minLength": 1 },
    "project": { "type": "object" },
    "files": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+" },
          "content": { "type": "string" }
        }
      }
    }
  }
}
