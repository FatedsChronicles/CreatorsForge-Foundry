{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorsforge.dev/foundry/project/v1",
  "title": "Creators Forge Foundry project manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "id",
    "version",
    "target",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "target": {
      "type": "object",
      "required": [
        "provider",
        "profile"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "template": {
      "type": "object",
      "required": ["id", "revision", "parameters"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*-v[0-9]+$" },
        "revision": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "summary", "authors", "licenseFile", "changelogFile", "tags", "dependencies", "signing"],
      "properties": {
        "packageName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "authors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "licenseFile": { "type": "string", "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.(?:md|txt)$" },
        "changelogFile": { "type": "string", "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.(?:md|txt)$" },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "repository": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "kind"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["runtime", "library", "tool"] },
              "license": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "format": "uri", "pattern": "^https?://" }
            }
          }
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "toolPath": { "type": "string", "minLength": 1 },
            "certificateThumbprint": { "type": "string", "minLength": 1 },
            "timestampUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "winForms": {
          "type": "boolean"
        },
        "mockRuntime": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "preview": {
      "type": "object",
      "required": ["enabled", "kind", "source", "width", "height"],
      "properties": {
        "enabled": { "type": "boolean" },
        "kind": { "enum": ["static-web", "winforms", "obs-component"] },
        "source": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.(?:html|cs|c)$"
        },
        "width": { "type": "integer", "minimum": 240, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 180, "maximum": 2160 }
      },
      "additionalProperties": true
    },
    "managedBuild": {
      "type": "object",
      "required": [
        "targetFramework",
        "languageVersion",
        "assemblyName",
        "sources"
      ],
      "properties": {
        "targetFramework": {
          "const": "net481"
        },
        "languageVersion": {
          "const": "7.3"
        },
        "assemblyName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.cs$"
          }
        }
      },
      "additionalProperties": true
    },
    "nativeBuild": {
      "type": "object",
      "required": ["language", "architecture", "toolchain", "sources"],
      "properties": {
        "language": { "const": "c17" },
        "architecture": { "const": "x64" },
        "toolchain": { "const": "cmake-msvc" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.c$"
          }
        }
      },
      "additionalProperties": true
    },
    "obsPlugin": {
      "type": "object",
      "required": ["contract", "moduleName", "entrySymbol", "displayName", "author", "description", "apiVersion"],
      "properties": {
        "contract": { "enum": ["module-load-v1", "libobs-module-v1"] },
        "moduleName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "entrySymbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "apiVersion": { "enum": ["32.1.1", "32.1.2"] },
        "sdkVersion": { "const": "32.1.2" },
        "design": {
          "type": "object",
          "required": ["template", "source", "componentId", "componentName"],
          "properties": {
            "template": {
              "enum": [
                "module-starter-v1",
                "passthrough-filter-v1",
                "configurable-filter-v1",
                "video-input-v1",
                "output-v1"
              ]
            },
            "source": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.c$"
            },
            "componentId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "componentName": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": { "contract": { "const": "libobs-module-v1" } },
            "required": ["contract"]
          },
          "then": {
            "required": ["sdkVersion"],
            "properties": { "apiVersion": { "const": "32.1.2" } }
          }
        },
        {
          "if": {
            "properties": { "contract": { "const": "module-load-v1" } },
            "required": ["contract"]
          },
          "then": {
            "properties": { "apiVersion": { "const": "32.1.1" } },
            "not": { "required": ["sdkVersion"] }
          }
        }
      ]
    },
    "cphInlineBridge": {
      "type": "object",
      "required": [
        "contract",
        "entryType",
        "entryMethod"
      ],
      "properties": {
        "contract": {
          "const": "args-log-v1"
        },
        "entryType": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"
        },
        "entryMethod": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "additionalProperties": true
    },
    "targetDefinition": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.json$"
    },
    "testDefinition": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.json$"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "managedLibrary",
          "cphInlineBridge",
          "streamerBotPackage",
          "obsPlugin",
          "obsPluginPackage"
        ]
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "outputs": {
            "contains": {
              "const": "managedLibrary"
            }
          }
        },
        "required": [
          "outputs"
        ]
      },
      "then": {
        "required": [
          "managedBuild"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outputs": {
            "contains": {
              "const": "cphInlineBridge"
            }
          }
        },
        "required": [
          "outputs"
        ]
      },
      "then": {
        "required": [
          "cphInlineBridge"
        ],
        "properties": {
          "outputs": {
            "contains": {
              "const": "managedLibrary"
            }
          },
          "target": {
            "properties": {
              "provider": {
                "const": "streamerbot"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outputs": {
            "contains": {
              "const": "streamerBotPackage"
            }
          }
        },
        "required": ["outputs"]
      },
      "then": {
        "required": ["targetDefinition"],
        "properties": {
          "target": {
            "properties": {
              "provider": { "const": "streamerbot" },
              "profile": {
                "enum": [
                  "1.0.4-stable",
                  "1.0.5-alpha.34",
                  "1.0.5-beta.1",
                  "1.0.5-beta.6",
                  "1.0.7-stable"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outputs": {
            "contains": { "const": "obsPlugin" }
          }
        },
        "required": ["outputs"]
      },
      "then": {
        "required": ["nativeBuild", "obsPlugin"],
        "properties": {
          "target": {
            "properties": {
              "provider": { "const": "obsstudio" },
              "profile": { "const": "32.x-windows-x64" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outputs": {
            "contains": { "const": "obsPluginPackage" }
          }
        },
        "required": ["outputs"]
      },
      "then": {
        "properties": {
          "outputs": { "contains": { "const": "obsPlugin" } }
        }
      }
    }
  ]
}
