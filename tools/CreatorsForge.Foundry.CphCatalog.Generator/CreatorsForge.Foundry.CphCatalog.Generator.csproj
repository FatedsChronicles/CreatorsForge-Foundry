<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.10" />
    <PackageReference
        Include="Microsoft.NETFramework.ReferenceAssemblies.net481"
        Version="1.0.3"
        GeneratePathProperty="true"
        PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CreatorsForge.Foundry.Editor\CreatorsForge.Foundry.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None
        Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net481)\build\.NETFramework\v4.8.1\**\*.dll"
        Link="ReferenceAssemblies\net481\%(RecursiveDir)%(Filename)%(Extension)"
        CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
